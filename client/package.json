{
  "name": "prunelle-client",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "openapi-typescript ../server/api/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "playwright test",
    "desktop": "go run .",
    "build:desktop": "pnpm build && go build -o build/prunelle .",
    "package:desktop": "go run github.com/egoist/mygo/cmd/mygo@v0.8.3 build",
    "test:native": "node scripts/native-smoke.mjs",
    "format:check": "prettier --check src tests scripts *.ts *.js *.json index.html"
  },
  "dependencies": {
    "@mygo-plugins/fetch": "0.8.3",
    "@pierre/diffs": "1.6.4",
    "@tanstack/react-query": "^5.90.0",
    "elkjs": "^0.11.0",
    "eventsource-parser": "^4.1.3",
    "mygo-runtime": "0.8.3",
    "openapi-fetch": "^0.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.6",
    "vitest": "^4.0.0"
  }
}
